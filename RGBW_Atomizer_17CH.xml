						<ChannelSet name="Open" from_dmx="0" to_dmx="0" />
						<ChannelSet name="Strobe slow..fast" from_dmx="1" to_dmx="255" />
					</ChannelFunction>
				</ChannelType>

				<!-- CH3  Red -->
				<ChannelType attribute="COLORRGB1" feature="COLOR" preset="COLOR" coarse="3">
					<ChannelFunction from="0" to="100" min_dmx_24="0" max_dmx_24="16777215" physfrom="0" physto="100" subattribute="COLORRGB1" attribute="COLORRGB1" feature="COLOR" preset="COLOR" />
