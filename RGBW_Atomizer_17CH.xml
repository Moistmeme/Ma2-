			<Info type="Revision" date="2026-08-31">RGBW effect fixture with background LED and atomizer, 17CH mode, built from manufacturer DMX chart</Info>
		</InfoItems>
		<short_name>RGBW17</short_name>
		<manufacturer>Generic</manufacturer>
		<short_manufacturer>Generic</short_manufacturer>
		<Modules>
